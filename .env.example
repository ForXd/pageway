# Without .env, the server uses the deterministic demo.
# Copy this file to .env for the verified anonymous free Kilo Gateway.
AGENT_MODE=openai
MODEL_BASE_URL=https://ai-gateway.kilo.ai/api/v1
MODEL_NAME=nvidia/nemotron-3.5-lightning:free
MODEL_API_KEY=
# Keep any credentials server-side. Never use VITE_ for secrets.
# Free model requests can take over a minute. Limits: docs/providers.md.
AGENT_TIMEOUT_MS=180000
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
