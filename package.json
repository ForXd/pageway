{
  "name": "pageway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "pnpm --filter './packages/*' build && pnpm --parallel --filter @zllling/pageway-playground --filter @zllling/pageway-server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter './packages/*' build && pnpm -r typecheck && tsc -p tsconfig.test.json && tsc -p tests/e2e/tsconfig.json && tsc -p tests/site/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "check:model": "tsx --env-file-if-exists=.env scripts/check-model.ts",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:pack": "node scripts/verify-packed.mjs",
    "release:preflight": "node scripts/release.mjs preflight",
    "release:dry-run": "node scripts/release.mjs dry-run",
    "check:all": "pnpm check && pnpm check:pack && pnpm test:e2e && pnpm test:site",
    "lint:fix": "biome lint --write .",
    "dev:site": "pnpm --filter './packages/*' build && pnpm --filter @zllling/pageway-site dev",
    "build:site": "pnpm --filter './packages/*' build && pnpm --filter @zllling/pageway-site build",
    "preview:site": "pnpm --filter @zllling/pageway-site preview",
    "test:site": "playwright test --config playwright.site.config.ts",
    "check:model:frontend": "tsx scripts/check-frontend-model.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "latest",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
